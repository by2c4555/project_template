# Workflow-owned execution controls. SAFE TO COMMIT.
# Never place credentials, passwords, tokens, API keys, private keys,
# authorization headers, session cookies, or secret-bearing URLs here.
# Real external access values belong in root `.env.user`.

ALLOW_PRODUCTION_ACCESS=false
ALLOW_DATABASE_WRITE=false

API_TIMEOUT_SECONDS=30
MAX_API_RETRIES=2

DEFAULT_SEARCH_ROUNDS=3
DEFAULT_ADDITIONAL_FILES=6
DEFAULT_LOG_LINES=200

TEST_DATA_LIMIT=100
LOG_LEVEL=INFO

MAX_REPAIR_ATTEMPTS=5
MAX_SAME_APPROACH_REPEATS=2
