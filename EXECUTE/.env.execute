# Non-secret execution controls only.
# This file is intended to be committed.
# Never place credentials, tokens, passwords, private keys, or secret-bearing URLs here.

ALLOW_PRODUCTION_ACCESS=false
ALLOW_DATABASE_WRITE=false

API_TIMEOUT_SECONDS=30
MAX_API_RETRIES=2

DEFAULT_EXTERNAL_IO_REPEATED_EQUIVALENT_CALLS=2
DEFAULT_TRANSIENT_RETRIES_PER_OPERATION=2

MAX_REPAIR_ATTEMPTS=2
MAX_SAME_APPROACH_REPEATS=1

LOG_LEVEL=INFO
